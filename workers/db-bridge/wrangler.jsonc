{
  "name": "mend-db",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mend",
      // Replace with the id printed by `wrangler d1 create mend --location weur` at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../drizzle"
    }
  ]
}
